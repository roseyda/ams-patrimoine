{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "style": "off",
    "restriction": "off"
  },
  "plugins": ["typescript"],
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }]
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".nuxt/**",
    ".data/**",
    ".output/**",
    ".github/**"
  ]
}
